# ── Atomik OS — pacchetti variante Desktop (base Kinoite / Plasma) ────────────
# Principio: riutilizzo massimo della base Kinoite. RIMOSSI rispetto a niri/SV:
#   compositor niri e tool wayland (grim/slurp/wf-recorder/swayidle/wl-clipboard),
#   dms/dms-greeter/greetd, nautilus (→ Dolphin), papirus (→ Breeze),
#   pavucontrol (→ audio Plasma), nm-connection-editor/network-manager-applet
#   (→ widget rete Plasma). Kinoite li fornisce già nativi.

# ── Shell e terminale ─────────────────────────────────────────────────────────
fish
# terminale: Konsole (già in Kinoite) — niente alacritty

# ── Sviluppo ─────────────────────────────────────────────────────────────────
git

# ── Multimedia ───────────────────────────────────────────────────────────────
# pipewire/wireplumber già in Kinoite; controllo audio nativo Plasma (niente pavucontrol)
pipewire
wireplumber
pipewire-pulseaudio
pipewire-alsa

# ── Utilità sistema ───────────────────────────────────────────────────────────
distrobox
podman
podman-compose
flatpak
NetworkManager
NetworkManager-wifi
bluez
bluez-tools

# ── Tool CLI moderni ─────────────────────────────────────────────────────────
eza
bat
ripgrep
fd-find
htop
fastfetch

# ── VPN e gestione rete ──────────────────────────────────────────────────────
# gestione rete via widget Plasma nativo; teniamo backend VPN CLI/plugin
NetworkManager-openvpn
wireguard-tools

# ── AppImage / filesystem / SMB ───────────────────────────────────────────────
fuse
fuse-libs
cifs-utils
