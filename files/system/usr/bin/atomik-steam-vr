#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════╗
# ║  Atomik OS — Steam in modalità VR                       ║
# ╚══════════════════════════════════════════════════════════╝
# Su Wayland la vista Desktop di SteamVR mostra lo schermo solo se Steam lo
# cattura via PipeWire (opzione -pipewire). Steam è a istanza singola: se è già
# aperto senza l'opzione, un secondo avvio la ignora. Questo script lo riavvia
# solo dopo conferma esplicita, perché chiude giochi e download in corso.
set -uo pipefail

STEAM_BIN="/usr/bin/steam"
TITLE="Steam (modalità VR)"
WAIT_SECONDS=30

# Riga di comando del client Steam in esecuzione (vuota se non è aperto).
steam_cmdline() {
    pgrep -a -x steam 2>/dev/null | head -n1
}

CURRENT="$(steam_cmdline)"

if [[ -n "$CURRENT" ]]; then
    if [[ "$CURRENT" == *" -pipewire"* ]]; then
        # Già in modalità VR: basta riportare Steam in primo piano.
        exec "$STEAM_BIN" steam://open/main
    fi

    kdialog --title "$TITLE" --warningyesno \
"Steam è già aperto senza la cattura PipeWire: la vista Desktop di SteamVR non mostrerebbe lo schermo.

Per attivarla Steam deve essere riavviato. I giochi aperti verranno chiusi e download o sincronizzazioni in corso potrebbero interrompersi.

Riavviare Steam in modalità VR?" || exit 0

    "$STEAM_BIN" -shutdown >/dev/null 2>&1 || true

    waited=0
    while [[ -n "$(steam_cmdline)" ]]; do
        if (( waited >= WAIT_SECONDS )); then
            kdialog --title "$TITLE" --error \
"Steam non si è chiuso entro ${WAIT_SECONDS} secondi. Chiudilo a mano e riprova."
            exit 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
fi

exec "$STEAM_BIN" -pipewire "$@"
